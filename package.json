{
  "name": "hk-sports-calendar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:data": "vitest run src/lib/data.test.ts",
    "check:export": "node scripts/check-export.mjs",
    "review:data": "node scripts/review-queue.mjs",
    "format": "prettier --write src tests scripts docs README.md package.json next.config.ts tsconfig.json vitest.config.ts .github .prettierrc.json",
    "test:http": "node scripts/smoke-http.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-hk": "5.3.1",
    "@fontsource/barlow-condensed": "5.3.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "prettier": "3.9.10",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
